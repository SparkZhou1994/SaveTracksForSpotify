# Spotify API 配置
# 复制此文件为 .env 并填入你的凭证

# 从 Spotify Developer Dashboard 获取
# 访问: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# 重定向URI (用于OAuth认证，需要在Spotify Dashboard中配置)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# 可选: 歌单默认配置
PLAYLIST_NAME=我的Spotify收藏
PLAYLIST_DESCRIPTION=从CSV文件导入的歌曲
ADD_TO_LIKED=true